{
  "name": "storybook-addon-palette-vault",
  "version": "1.0.0",
  "description": "Shows which colors a story actually renders, ranked by how much of the component each one covers, with OKLCH values and contrast.",
  "keywords": [
    "storybook-addons",
    "storybook-addon",
    "color",
    "colour",
    "oklch",
    "design-system",
    "accessibility",
    "contrast"
  ],
  "homepage": "https://palettevault.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaletteVault/storybook-addon-palette-vault"
  },
  "bugs": {
    "url": "https://github.com/PaletteVault/storybook-addon-palette-vault/issues"
  },
  "license": "MIT",
  "author": "Anton Liverant <anliberant@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "icon.png",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build-storybook": "storybook build",
    "build:watch": "npm run build -- --watch",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/icons": "^2.0.0",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "^20",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.5.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.5.7",
    "ts-dedent": "^2.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.0.5"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Palette Vault",
    "unsupportedFrameworks": [
      "react-native"
    ],
    "icon": "https://palettevault.github.io/icon-192.png"
  }
}
